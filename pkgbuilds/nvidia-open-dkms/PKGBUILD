# Carries NVIDIA fixes that are still pending upstream, on both architectures:
# a per-frame nvkms leak (#1368), and on hybrid laptops the GPU waking for
# every battery percent (#1299) and power-off hanging after hibernation (#1412).
# On ARM it also carries the N1x display fixes: target-luminance brightness for
# eDP 1.5 OLED panels, both displays of a dock on one USB4 port, and lighting a
# DisplayPort monitor again when it comes back after an unplug.
# Drop each patch once NVIDIA ships it; remove the ARM part of this overlay
# after a fixed Arch Linux ARM driver is validated.
pkgname=nvidia-open-dkms
pkgver=615.78.08
pkgrel=4
pkgdesc="NVIDIA open kernel modules - module sources"
arch=('aarch64' 'x86_64')
url="https://www.nvidia.com/"
license=('MIT AND GPL-2.0-only')
depends=('dkms' "nvidia-utils=$pkgver")
conflicts=('nvidia-open' 'NVIDIA-MODULE')
provides=('nvidia-open' 'NVIDIA-MODULE' 'nvidia-dkms')
replaces=('nvidia-dkms')
options=('!strip')
_pkg_open="NVIDIA-kernel-module-source-${pkgver}"
source=("https://download.nvidia.com/XFree86/NVIDIA-kernel-module-source/${_pkg_open}.tar.xz"
        '0008-free-the-semaphore-surface-callback-when-the-waiter-is-already-signalled.patch'
        '0010-fix-the-dynamic-power-refcount-underflow-in-the-nvpcf-notify-path.patch'
        '0011-defer-nvpcf-notifications-while-the-gpu-is-runtime-suspended.patch'
        '0012-skip-teardown-at-shutdown-while-the-gpu-is-hibernate-suspended.patch')
source_aarch64=('0003-set-oled-edp-brightness-over-aux.patch'
                '0004-drive-both-displays-of-a-dock-on-one-n1x-usb4-port.patch'
                '0005-retrain-the-link-after-the-sink-was-unplugged.patch'
                '0006-set-a-mode-afresh-on-a-sink-that-comes-back-through-a-usb4-tunnel.patch'
                '0007-train-a-tunnelled-link-again-when-the-sink-cannot-decode-it.patch'
                '0009-report-usb-c-connectors-as-displayport.patch')
sha512sums=('5ced2c7e3e9df21f8494ea439ac2103307fcbcb295a3f11e5fdf4f1dbeda3f0b13800a06f8147ebd064f98897c24e92f5de82023a8ca43a582694d951c9620c9'
            'b4bb8dd8e558e2091c72ca8fee09c1e716228813570b3ffccac98a5af030a47f2d029da388fc8ef84471cc9b5fa7291eeb07f09966d414d45a88593ca16ecd65'
            '97d7b46f9013605a985bbb42a11422796b0f90060c809bf1dae9ea2ed6a9bfe067f58d288771931e4eb6b67b5fec20edbdda7384ea0002a961f05bd40bc4218c'
            '5ef634e3ac9c6df70a0ac08a7825eb24d949b01a06fdf7abee9b67e44641a964da8ddd3f148b0d8a9ac5fd7bbf9707b15bb68aecbf72e4d469468d4f223efaff'
            'fa941d240c7ac3abaee296df877f3f45ea66af19053fb56d2ccbf34065b4a92c62915d0f56f0cf102ab22fd93c232d36137679157b78f73f6885cf39915ea6ee')
sha512sums_aarch64=('a1aca87a79ceda3280ee2c6e40f5b445925f2652ef2adfa178a9c0a2b7de3e027e73c58e16a71275efd1f103e04313e295e7c71ffa974e8f3ded4bcffce27c23'

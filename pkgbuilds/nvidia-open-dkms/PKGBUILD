                    '119fc26f6672e42ca95684dab2dff9885844a324de4146fc7b646e8ede4a2734b74fca2b5c8257db45bc7e195a9b14b44b78b281a4dc78fde2279aa643a64762'
                    '3933ac2957bfe8b044f25de904ae399f999795f48e5cf90d1300316506bf09d2cfa5ddd4394ec7e685f56c3ab735b3b03f8660ec87edd35d41ecff37db574e24'
                    'b7088723a29f191e00f1c47fb69ba6eb02177155b4177d612404e2dba63ab366a34927ea671c48556977f52b27ad086b5f810ded1582dada1abaa8fa528b5cbe'
                    'c587ca66ecb4e6bcf4298ce6f54d977ee2b14ccbdfc5b37c5388adfbdcfed4e478695883b72b03401ef7ee55af7ea1a200e4f24ddde437c5a138e76b95a8ba1e')

prepare() {
    # Attempt to make builds reproducible
    sed -i "s/^  HOSTNAME.*/  HOSTNAME = echo archlinux/" "${srcdir}/${_pkg_open}/utils.mk"
    sed -i "s/^WHOAMI.*/WHOAMI = echo archlinux-builder/" "${srcdir}/${_pkg_open}/utils.mk"
    sed -i "s/^DATE.*/DATE = date -r version.mk/" "${srcdir}/${_pkg_open}/utils.mk"

    for conf in "${srcdir}/${_pkg_open}/kernel-open/dkms.conf"; do
        sed -i "s/__VERSION_STRING/${pkgver}/" "$conf"
        sed -i 's/__JOBS/`nproc`/' "$conf"
        sed -i 's/__EXCLUDE_MODULES//' "$conf"
        sed -i 's/__DKMS_MODULES//' "$conf"
        sed -i 's/NV_EXCLUDE_BUILD_MODULES/IGNORE_PREEMPT_RT_PRESENCE=1 NV_EXCLUDE_BUILD_MODULES/' "$conf"
        sed -i '$i\
BUILT_MODULE_NAME[0]="nvidia"\
DEST_MODULE_LOCATION[0]="/kernel/drivers/video"\
BUILT_MODULE_NAME[1]="nvidia-uvm"\
DEST_MODULE_LOCATION[1]="/kernel/drivers/video"\
BUILT_MODULE_NAME[2]="nvidia-modeset"\
DEST_MODULE_LOCATION[2]="/kernel/drivers/video"\
BUILT_MODULE_NAME[3]="nvidia-drm"\
DEST_MODULE_LOCATION[3]="/kernel/drivers/video"\
BUILT_MODULE_NAME[4]="nvidia-peermem"\
DEST_MODULE_LOCATION[4]="/kernel/drivers/video"' "$conf"
    done

    # Additional parameters for open kernel modules
    cat <<EOF >>"${srcdir}/${_pkg_open}/kernel-open/dkms.conf"
BUILT_MODULE_LOCATION[0]="kernel-open"
BUILT_MODULE_LOCATION[1]="kernel-open"
BUILT_MODULE_LOCATION[2]="kernel-open"
BUILT_MODULE_LOCATION[3]="kernel-open"
BUILT_MODULE_LOCATION[4]="kernel-open"
EOF

    cd "${srcdir}/${_pkg_open}"

    if [[ $CARCH == aarch64 ]]; then
      # The XPS 16 (N1x)'s OLED panel takes its brightness as a target luminance,
      # which the GPU firmware never sets.
      patch --batch --fuzz=0 -p1 < "$srcdir/0003-set-oled-edp-brightness-over-aux.patch"

      # The N1x GPU firmware lets one display through each USB4 port, so a
      # dock's second display never lights.
      patch --batch --fuzz=0 -p1 < "$srcdir/0004-drive-both-displays-of-a-dock-on-one-n1x-usb4-port.patch"

      # A monitor that comes back after an unplug with its head still attached
      # (behind a USB4 dock, every time the dock's DisplayPort tunnel is rebuilt)
      # got no link training and stayed black.
      patch --batch --fuzz=0 -p1 < "$srcdir/0005-retrain-the-link-after-the-sink-was-unplugged.patch"

      # Behind a USB4 dock, a monitor that came back before the client noticed it
      # was unplugged got its old head revived on a new DisplayPort tunnel and
      # stayed black. Report it unplugged until that head is shut down.
      patch --batch --fuzz=0 -p1 < "$srcdir/0006-set-a-mode-afresh-on-a-sink-that-comes-back-through-a-usb4-tunnel.patch"

      # Behind a USB4 dock, a monitor could come out of standby black with its
      # link reading as trained while it could not decode it. Check the sink's
      # symbol error counters after a modeset and train the link again.
      patch --batch --fuzz=0 -p1 < "$srcdir/0007-train-a-tunnelled-link-again-when-the-sink-cannot-decode-it.patch"
    fi

    # nvkms leaked a callback record whenever a semaphore surface fence had
    # already signalled, which under explicit sync is most composited frames.
    # NVIDIA PR #1368.
    patch --batch --fuzz=0 -p1 < "$srcdir/0008-free-the-semaphore-surface-callback-when-the-waiter-is-already-signalled.patch"

    if [[ $CARCH == aarch64 ]]; then
      # nvidia-drm reported USB-C outputs (a USB4 dock's displays on the N1x) as
      # "Unknown", which systemd-logind does not count as external displays, so
      # closing the lid on a dock suspended instead of staying on the dock.
      patch --batch --fuzz=0 -p1 < "$srcdir/0009-report-usb-c-connectors-as-displayport.patch"
    fi

    # On a hybrid laptop the firmware sends an NVPCF notification on every
    # battery percent; each one woke a runtime-suspended GPU for 20-25 s (+6-9 W).
    # Notifications are coalesced while the GPU sleeps and replayed on resume.
    # Lars Nieradzik's NVIDIA PR #1299, both commits.
    patch --batch --fuzz=0 -p1 < "$srcdir/0010-fix-the-dynamic-power-refcount-underflow-in-the-nvpcf-notify-path.patch"
    patch --batch --fuzz=0 -p1 < "$srcdir/0011-defer-nvpcf-notifications-while-the-gpu-is-runtime-suspended.patch"

    # After the hibernation image was written, power-off hung in
    # nv_pci_shutdown() tearing down a GPU that was still suspended (thaw is a
    # no-op). Hans van Essen's NVIDIA PR #1412.
    patch --batch --fuzz=0 -p1 < "$srcdir/0012-skip-teardown-at-shutdown-while-the-gpu-is-hibernate-suspended.patch"
}

package() {
    install -dm755 "$pkgdir/usr/src"
    cp -dr --no-preserve=ownership "$srcdir/$_pkg_open" "$pkgdir/usr/src/nvidia-$pkgver"
    mv "$pkgdir/usr/src/nvidia-$pkgver/kernel-open/dkms.conf" "$pkgdir/usr/src/nvidia-$pkgver/dkms.conf"
    install -Dm644 "$srcdir/$_pkg_open/COPYING" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
